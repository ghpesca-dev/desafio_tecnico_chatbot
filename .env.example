# Obrigatória para conversar. Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Precisa aceitar tool calling.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Opcional. Deixe vazio com modelos que não aceitam temperature, como o padrão.
OPENROUTER_TEMPERATURE=

# Opcional. Fixa a data dos prazos (AAAA-MM-DD). Vazio usa a data de hoje.
EMPORIO_DATA_REFERENCIA=
